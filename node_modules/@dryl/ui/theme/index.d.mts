export interface VscodeTheme {
  type?: 'light' | 'dark' | string;
  colors?: Record<string, string>;
  tokenColors?: unknown[];
}

export type DrylThemeTokens = Record<`--${string}`, string>;

export function mapVscodeColorsToDryl(colors: Record<string, string>): DrylThemeTokens;
export function mapVscodeThemeToDryl(theme: VscodeTheme): DrylThemeTokens;
