{
  "name": "@dryl/ui",
  "version": "0.6.13",
  "description": "Reusable Angular UI components and theming system",
  "keywords": [
    "angular",
    "ui",
    "components",
    "theming"
  ],
  "author": "dryl",
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": "^21.1.0",
    "@angular/core": "^21.1.0"
  },
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "module": "fesm2022/dryl-ui.mjs",
  "typings": "types/dryl-ui.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/dryl-ui.d.ts",
      "default": "./fesm2022/dryl-ui.mjs"
    },
    "./theme": {
      "default": "./theme/index.mjs"
    },
    "./styles": {
      "default": "./src/lib/styles/index.scss"
    },
    "./styles/layout": {
      "default": "./src/lib/styles/_layout.scss"
    }
  },
  "type": "module",
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
